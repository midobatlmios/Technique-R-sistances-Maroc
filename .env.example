# Copy to .env.local (local) and add the same variables in Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys. Without it, the form works in demo mode (no email sent).
RESEND_API_KEY=

# Where quote requests are delivered (several addresses: separate with commas).
QUOTE_TO_EMAIL=

# Sender address. Until the client's domain is verified in Resend, keep onboarding@resend.dev:
# it can only deliver to the email address of the Resend account owner.
QUOTE_FROM_EMAIL=Site TRM <onboarding@resend.dev>

# Demo mode: set to 1 on the demo deployment to show content still waiting on the client
# (placeholder email, empty reference slots, "[à compléter]" legal fields). Leave unset on the live site.
NEXT_PUBLIC_DEMO=

# Click tracking (calls, WhatsApp, itinerary, quote clicks and quotes sent) with Umami:
# create a free account at https://cloud.umami.is, add the website, and paste its Website ID here.
# Cookieless, so no consent banner is needed. Leave empty to disable tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only if Umami is self-hosted (default: https://cloud.umami.is/script.js).
NEXT_PUBLIC_UMAMI_SRC=
